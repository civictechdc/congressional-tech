{
  "apiVersion": "v3.2.0",
  "kind": "DataContract",
  "id": "urn:congressional-tech:archive:table:meeting_coverage",
  "version": "1.0.0",
  "name": "Congressional Tech Archive Table: meeting_coverage",
  "status": "active",
  "domain": "congressional-archive",
  "description": {
    "purpose": "Typed coverage facts per meeting",
    "usage": "See what the catalog records about recordings, transcripts, documents, witnesses and captions for each meeting. Unknown and not-stated values do not mean that materials do not exist."
  },
  "authoritativeDefinitions": [
    {
      "type": "definition",
      "url": "urn:congressional-tech:archive:release"
    }
  ],
  "customProperties": [
    {
      "vendor": "congressional-tech",
      "property": "schemaVersion",
      "value": 1
    },
    {
      "vendor": "congressional-tech",
      "property": "relationshipsVersion",
      "value": 1
    }
  ],
  "schema": [
    {
      "id": "meeting_coverage",
      "name": "meeting_coverage",
      "logicalType": "object",
      "physicalType": "table",
      "physicalName": "meeting_coverage.parquet",
      "businessName": "Typed coverage facts per meeting",
      "dataGranularityDescription": "One aspect of one meeting: recording, transcript, documents, witnesses or captions",
      "description": "See what the catalog records about recordings, transcripts, documents, witnesses and captions for each meeting. Unknown and not-stated values do not mean that materials do not exist.",
      "properties": [
        {
          "name": "event_id",
          "logicalType": "integer",
          "logicalTypeOptions": {
            "format": "i64"
          },
          "physicalType": "BIGINT",
          "customProperties": [
            {
              "vendor": "ddk",
              "property": "concept",
              "value": "urn:ddk:legislative:concept:event-id"
            },
            {
              "vendor": "ddk",
              "property": "conceptKind",
              "value": "identifier"
            },
            {
              "vendor": "congressional-tech",
              "property": "representationNote",
              "value": "64-bit integer event ID."
            }
          ],
          "authoritativeDefinitions": [
            {
              "type": "definition",
              "url": "urn:ddk:legislative:concept:event-id"
            }
          ],
          "required": true,
          "description": "Meeting event ID",
          "primaryKey": true,
          "primaryKeyPosition": 1
        },
        {
          "name": "aspect",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": true,
          "description": "recording, transcript, documents, witnesses or captions",
          "primaryKey": true,
          "primaryKeyPosition": 2
        },
        {
          "name": "state",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            },
            {
              "vendor": "congressional-tech",
              "property": "fieldNote",
              "value": "confirmed_absent only from an undisputed curated negative verdict with event scope; package context alone does not establish absence and zero rows never prove absence. partial means excerpts only; claimed means only a video’s own text; for captions, no observation is unknown, never empty. States rank present > unresolved > empty > unknown > not_stated: unknown, never not_stated, where held evidence is not yet linked. A Senate meeting is unknown for documents and witnesses until Senate committee-page links land (ct-gi01 R2). Captions are not_stated only when the recording is confirmed_absent or not_public."
            }
          ],
          "required": true,
          "description": "present, partial, claimed, empty, not_stated, unresolved, not_public, confirmed_absent or unknown; these never merge"
        },
        {
          "name": "basis",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": true,
          "description": "Which relation states it"
        },
        {
          "name": "count",
          "logicalType": "integer",
          "logicalTypeOptions": {
            "format": "i32"
          },
          "physicalType": "INTEGER",
          "required": true,
          "description": "Rows behind present"
        },
        {
          "name": "reason",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": false,
          "description": "Why a state holds, when known: recording_decision_unresolved_or_conflicting, package_context_only, video_text_only, excerpts_only, stated_documents_not_held, senate_page_links_pending, package_witnesses_unattached, member_appearances_only (empty: the people the meeting lists, on its own list or, tied to no meeting, on a print it links, are Members of Congress, perhaps with record entries, and no outside witness), nominee_not_listed (unknown: a nomination hearing whose list names only Members, so its nominee is missing), package_names_meeting_unlinked, recording_link_pending or recording_without_video_record; for a present transcript, the sources held (printed_hearing, committee_transcript, captions)"
        }
      ],
      "customProperties": [
        {
          "vendor": "congressional-tech",
          "property": "producer",
          "value": "archive"
        },
        {
          "vendor": "congressional-tech",
          "property": "identity",
          "value": {
            "fields": [
              "event_id",
              "aspect"
            ],
            "scope": "published identifier",
            "validation": "native publication key checks",
            "kind": "primary_key"
          }
        },
        {
          "vendor": "congressional-tech",
          "property": "nullabilityBasis",
          "value": "The documents are silent; entity-meeting-coverage.sql always sets basis (a CASE with an else) and count (coalesced), so both are required; reason is stated only when known."
        },
        {
          "vendor": "congressional-tech",
          "property": "archiveRelationships",
          "value": [
            {
              "id": "coverage_meeting",
              "source": {
                "table": "meeting_coverage",
                "fields": [
                  "event_id"
                ]
              },
              "target": {
                "table": "meetings",
                "fields": [
                  "event_id"
                ]
              },
              "meaning": "The meeting a coverage fact describes.",
              "cardinality": "many-to-one",
              "nullable": false,
              "resolution": "required",
              "match": "equal",
              "scope": "selected release"
            }
          ]
        }
      ],
      "relationships": [
        {
          "id": "coverage_meeting",
          "type": "foreignKey",
          "from": "meeting_coverage.event_id",
          "to": "meetings.event_id",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "cardinality",
              "value": "many-to-one"
            },
            {
              "vendor": "congressional-tech",
              "property": "resolution",
              "value": "required"
            },
            {
              "vendor": "congressional-tech",
              "property": "nullable",
              "value": false
            }
          ]
        }
      ]
    }
  ]
}
