          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              },
              {
                "vendor": "ddk",
                "property": "concept",
                "value": "urn:ddk:legislative:concept:bioguide-id"
              },
              {
                "vendor": "ddk",
                "property": "conceptKind",
                "value": "identifier"
              }
            ],
            "authoritativeDefinitions": [
              {
                "type": "definition",
                "url": "urn:ddk:legislative:concept:bioguide-id"
              }
            ],
            "description": "Referenced member Bioguide identifier."
          },
          "required": true,
          "description": "Member Bioguide identifiers"
        },
        {
          "name": "witness_keys",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              },
              {
                "vendor": "ddk",
                "property": "concept",
                "value": "urn:congressional-tech:concept:witness-key"
              },
              {
                "vendor": "ddk",
                "property": "conceptKind",
                "value": "identifier"
              }
            ],
            "authoritativeDefinitions": [
              {
                "type": "definition",
                "url": "urn:congressional-tech:concept:witness-key"
              }
            ],
            "description": "Referenced witness appearance identifier."
          },
          "required": true,
          "description": "Witness appearance identifiers"
        },
        {
          "name": "version_keys",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              }
            ],
            "description": "Shared lowercase hexadecimal endpoint keys identify different editions, not alternate formats of one document. A document can have several keys."
          },
          "required": true,
          "description": "Hex endpoint keys shared by editions"
        }
      ],
      "customProperties": [
        {
          "vendor": "congressional-tech",
          "property": "producer",
          "value": "archive"
        },
        {
          "vendor": "congressional-tech",
          "property": "identity",
          "value": {
            "fields": [
              "list_row"
            ],
            "scope": "release",
            "validation": "shared ordered native export",
            "kind": "row_position",
            "note": "list_row is virtual: zero-based physical row position, continued across manifest shard row ranges. Never reuse it across releases."
          }
        },
        {
          "vendor": "congressional-tech",
          "property": "nullabilityBasis",
          "value": "Nullability transcribes data model §8.1 (list.parquet bullet): a type without \"nullable\" there is required."
        },
        {
          "vendor": "congressional-tech",
          "property": "gaps",
          "value": [
            "Date bounds span accepted document dates only and Congress bounds skip suspect-dated documents; document_dates counts accepted, suspect and undated documents. Bounds are observed values, not evidence of complete coverage"
          ]
        },
        {
          "vendor": "congressional-tech",
          "property": "virtualColumns",
          "value": [
            {
              "name": "list_row",
              "type": "int64",
              "meaning": "Zero-based release-local physical row position; readers add this column"
            }
          ]
        },
        {
          "vendor": "congressional-tech",
          "property": "archiveRelationships",
          "value": [
