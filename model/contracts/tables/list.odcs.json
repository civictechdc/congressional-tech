              "cardinality": "many-to-many",
              "nullable": true,
              "resolution": "required",
              "match": "equal",
              "scope": "selected release"
            },
            {
              "id": "document_editions",
              "source": {
                "table": "list",
                "fields": [
                  "version_keys[]"
                ]
              },
              "target": {
                "table": "list",
                "fields": [
                  "version_keys[]"
                ]
              },
              "meaning": "Different document rows sharing a version endpoint key; exclude the same row and deduplicate when keys overlap.",
