              "meaning": "Committee attribution; does not imply authorship.",
              "cardinality": "many-to-many",
              "nullable": true,
              "resolution": "unresolved_allowed",
              "match": "equal",
              "scope": "selected release"
            },
            {
              "id": "document_bills",
              "source": {
                "table": "list",
                "fields": [
                  "measure_keys[]"
                ]
              },
              "target": {
                "table": "bills",
                "fields": [
