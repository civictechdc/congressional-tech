              "cardinality": "many-to-many",
              "nullable": true,
              "resolution": "unresolved_allowed",
              "match": "equal",
              "scope": "selected release"
            },
            {
              "id": "document_nominations",
              "source": {
                "table": "list",
                "fields": [
                  "measure_keys[]"
                ]
              },
              "target": {
                "table": "nominations",
                "fields": [
