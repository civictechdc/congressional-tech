              "cardinality": "many-to-many",
              "nullable": true,
              "resolution": "required",
              "match": "decimal_string_to_integer",
              "scope": "selected release"
            },
            {
              "id": "document_committees",
              "source": {
                "table": "list",
                "fields": [
                  "committee_keys[]"
                ]
              },
              "target": {
