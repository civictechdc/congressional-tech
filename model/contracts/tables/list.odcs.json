{
  "apiVersion": "v3.2.0",
  "kind": "DataContract",
  "id": "urn:congressional-tech:archive:table:list",
  "version": "1.0.0",
  "name": "Congressional Tech Archive Table: list",
  "status": "active",
  "domain": "congressional-archive",
  "description": {
    "purpose": "Searchable documents",
    "usage": "Browse and search document editions included in this release."
  },
  "authoritativeDefinitions": [
    {
      "type": "definition",
      "url": "urn:congressional-tech:archive:release"
    }
  ],
  "customProperties": [
    {
      "vendor": "congressional-tech",
      "property": "schemaVersion",
      "value": 1
    },
    {
      "vendor": "congressional-tech",
      "property": "relationshipsVersion",
      "value": 1
    }
  ],
  "schema": [
    {
      "id": "list",
      "name": "list",
      "logicalType": "object",
      "physicalType": "table",
      "physicalName": "list.parquet",
      "businessName": "Searchable documents",
      "dataGranularityDescription": "One document edition in this release",
      "description": "Browse and search document editions included in this release.",
      "properties": [
        {
          "name": "filename",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "required": true,
          "description": "Displayed filename"
        },
        {
          "name": "title",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "required": false,
          "description": "Document or publisher title when known"
        },
        {
          "name": "print_number",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "required": false,
          "description": "Official hearing print number (such as S. Hrg. 117-336 or Serial No. 115-3) from GovInfo MODS preferredCitation or Content Details when known"
        },
        {
          "name": "document_kind",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              }
            ],
            "description": "Embedded classification values, not foreign keys. Words listed together under synonyms name one kind (the first is the House naming guide's word); filter them as one."
          },
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archiveValueSynonyms",
              "value": [
                [
                  "witness-statement",
                  "testimony"
                ],
                [
                  "committee-amendment",
                  "amendment"
                ],
                [
                  "witness-biography",
                  "biography"
                ],
                [
                  "member-statement",
                  "opening-statement"
                ],
                [
                  "committee-transcript",
                  "transcript"
                ]
              ]
            }
          ],
          "required": true,
          "description": "Document kinds"
        },
        {
          "name": "document_family",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              }
            ],
            "description": "Embedded filename classification values."
          },
          "required": true,
          "description": "Filename document families"
        },
        {
          "name": "committee_keys",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              },
              {
                "vendor": "ddk",
                "property": "concept",
                "value": "urn:ddk:legislative:concept:committee-code"
              },
              {
                "vendor": "ddk",
                "property": "conceptKind",
                "value": "identifier"
              }
            ],
            "authoritativeDefinitions": [
              {
                "type": "definition",
                "url": "urn:ddk:legislative:concept:committee-code"
              }
            ],
            "description": "Congress.gov committee system code associated with this document."
          },
          "required": true,
          "description": "Congress.gov committee system codes"
        },
        {
          "name": "chambers",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              }
            ],
            "description": "Embedded chamber labels."
          },
          "required": true,
          "description": "Chambers associated with the document"
        },
        {
          "name": "congress",
          "logicalType": "integer",
          "logicalTypeOptions": {
            "format": "i16"
          },
          "physicalType": "SMALLINT",
          "required": false,
          "description": "Congress number when unambiguous"
        },
        {
          "name": "format",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": true,
          "description": "Original file format"
        },
        {
          "name": "document_date",
          "logicalType": "date",
          "logicalTypeOptions": {
            "format": "yyyy-MM-dd"
          },
          "physicalType": "DATE",
          "required": false,
          "description": "Date of the document as read; document_date_status says whether it is accepted or suspect"
        },
        {
          "name": "document_date_status",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": false,
          "description": "accepted, or suspect for a filename date more than 30 days after first_captured or outside the tagged Congress's years (one year of margin); document_date keeps the literal reading either way; null when undated"
        },
        {
          "name": "first_captured",
          "logicalType": "date",
          "logicalTypeOptions": {
            "format": "yyyy-MM-dd"
          },
          "physicalType": "DATE",
          "required": false,
          "description": "First good fetch date"
        },
        {
          "name": "date_kind",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": true,
          "description": "Basis of the archive date"
        },
        {
          "name": "saved_kind",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": true,
          "description": "Original file or recovery"
        },
        {
          "name": "hidden",
          "logicalType": "boolean",
          "physicalType": "BOOLEAN",
          "required": true,
          "description": "Excluded from search by review; public links still resolve"
        },
        {
          "name": "meeting_keys",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              },
              {
                "vendor": "ddk",
                "property": "concept",
                "value": "urn:ddk:legislative:concept:event-id"
              },
              {
                "vendor": "ddk",
                "property": "conceptKind",
                "value": "identifier"
              },
              {
                "vendor": "congressional-tech",
                "property": "representationNote",
                "value": "Decimal string event ID; joins meetings.event_id via integer cast."
              }
            ],
            "authoritativeDefinitions": [
              {
                "type": "definition",
                "url": "urn:ddk:legislative:concept:event-id"
              }
            ],
            "description": "Decimal event identifier associated with this document."
          },
          "required": true,
          "description": "Decimal event IDs"
        },
        {
          "name": "measure_keys",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
            "customProperties": [
              {
                "vendor": "congressional-tech",
                "property": "archivePhysicalEncoding",
                "value": "dictionary"
              },
              {
                "vendor": "ddk",
                "property": "concept",
                "value": "urn:congressional-tech:concept:measure-key"
              },
              {
                "vendor": "ddk",
                "property": "conceptKind",
                "value": "identifier"
              },
              {
                "vendor": "congressional-tech",
                "property": "relatedConcepts",
                "value": [
                  "urn:ddk:legislative:concept:bill-id",
