                ]
              },
              "meaning": "Exact typed measure identifiers; values for the other measure type do not match.",
              "cardinality": "many-to-many",
              "nullable": true,
              "resolution": "unresolved_allowed",
              "match": "equal",
              "scope": "selected release"
            },
