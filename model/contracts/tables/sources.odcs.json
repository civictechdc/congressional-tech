              "cardinality": "many-to-one",
              "nullable": false,
              "resolution": "required",
              "match": "equal",
              "scope": "selected release"
            },
            {
              "id": "source_address",
              "source": {
                "table": "sources",
                "fields": [
                  "url"
                ]
              },
              "target": {
                "external": "web URL"
