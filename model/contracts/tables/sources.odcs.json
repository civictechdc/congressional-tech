{
  "apiVersion": "v3.2.0",
  "kind": "DataContract",
  "id": "urn:congressional-tech:archive:table:sources",
  "version": "1.0.0",
  "name": "Congressional Tech Archive Table: sources",
  "status": "active",
  "domain": "congressional-archive",
  "description": {
    "purpose": "Publisher addresses and listing context",
    "usage": "Inspect source addresses and listing context captured for each document. Each source occurrence remains separate."
  },
  "authoritativeDefinitions": [
    {
      "type": "definition",
      "url": "urn:congressional-tech:archive:release"
    }
  ],
  "customProperties": [
    {
