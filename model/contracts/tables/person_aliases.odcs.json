              "vendor": "ddk",
              "property": "concept",
              "value": "urn:ddk:entity:concept:person-id"
            },
            {
              "vendor": "ddk",
              "property": "conceptKind",
              "value": "identifier"
            },
            {
              "vendor": "congressional-tech",
              "property": "representationNote",
              "value": "Archive person_key (Bioguide ID or 16-hex hash)."
            },
            {
              "vendor": "congressional-tech",
              "property": "fieldNote",
              "value": "Disjoint from people.person_key; a key published again leaves person_aliases. Any vanished prior person_key absent from both people and person_aliases refuses export (lost_person_keys)."
            }
          ],
          "authoritativeDefinitions": [
            {
              "type": "definition",
              "url": "urn:ddk:entity:concept:person-id"
            }
          ],
          "required": true,
          "description": "A previously published person_key no longer present in people.parquet",
          "primaryKey": true,
          "primaryKeyPosition": 1
        },
        {
          "name": "person_key",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "ddk",
              "property": "concept",
              "value": "urn:ddk:entity:concept:person-id"
            },
            {
              "vendor": "ddk",
              "property": "conceptKind",
              "value": "identifier"
            },
            {
              "vendor": "congressional-tech",
              "property": "representationNote",
              "value": "Archive person_key (Bioguide ID or 16-hex hash)."
            }
          ],
          "authoritativeDefinitions": [
            {
              "type": "definition",
              "url": "urn:ddk:entity:concept:person-id"
            }
          ],
          "required": false,
          "description": "Current people.person_key when status is unambiguous; null when status is ambiguous or unresolved"
        },
        {
          "name": "status",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
