                ]
              },
              "target": {
                "table": "people",
                "fields": [
                  "person_key"
                ]
              },
              "meaning": "Candidate current person rows when a retired person_key split ambiguously.",
              "cardinality": "many-to-many",
              "nullable": false,
              "resolution": "required",
              "match": "equal",
              "scope": "selected release"
            }
          ]
        }
      ],
      "relationships": [
        {
          "id": "person_alias_target",
          "type": "foreignKey",
          "from": "person_aliases.person_key",
          "to": "people.person_key",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "cardinality",
              "value": "many-to-one"
            },
            {
              "vendor": "congressional-tech",
              "property": "resolution",
              "value": "required"
            },
            {
              "vendor": "congressional-tech",
              "property": "nullable",
              "value": true
            }
          ]
        }
      ]
