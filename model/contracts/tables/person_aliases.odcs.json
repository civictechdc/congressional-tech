          "description": "Release SHA-256 of the last published release in which old_person_key appeared in people.parquet"
        },
        {
          "name": "candidate_keys",
          "logicalType": "array",
          "physicalType": "VARCHAR[]",
          "items": {
            "logicalType": "string",
            "physicalType": "VARCHAR",
