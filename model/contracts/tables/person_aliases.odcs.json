              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": true,
          "description": "unambiguous (one successor), ambiguous (split across candidate_keys, none chosen), or unresolved (no current person row)"
        },
        {
          "name": "kind",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
            {
              "vendor": "congressional-tech",
              "property": "archivePhysicalEncoding",
              "value": "dictionary"
            }
          ],
          "required": false,
          "description": "Transition kind: regrouped, merged, split, or hidden; null when status is unresolved"
        },
        {
          "name": "decision_id",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "required": false,
          "description": "Identifier of the reviewed decision in model/registries/person-decisions.json when applicable; null for rule-driven transitions"
        },
        {
          "name": "last_release_id",
          "logicalType": "string",
          "physicalType": "VARCHAR",
