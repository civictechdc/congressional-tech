            "validation": "native publication key checks",
            "kind": "primary_key"
          }
        },
        {
          "vendor": "congressional-tech",
          "property": "nullabilityBasis",
          "value": "person_key is set exactly when status is unambiguous; kind is null exactly when status is unresolved; candidate_keys has two or more entries exactly when status is ambiguous."
        },
        {
          "vendor": "congressional-tech",
          "property": "archiveRelationships",
          "value": [
            {
              "id": "person_alias_target",
              "source": {
                "table": "person_aliases",
                "fields": [
                  "person_key"
                ]
              },
              "target": {
                "table": "people",
                "fields": [
                  "person_key"
                ]
              },
