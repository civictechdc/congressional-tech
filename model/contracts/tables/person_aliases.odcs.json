      "name": "person_aliases",
      "logicalType": "object",
      "physicalType": "table",
      "physicalName": "person_aliases.parquet",
      "businessName": "Retired person_key redirects and split notices",
      "dataGranularityDescription": "One previously published person_key not in people.parquet, carried one hop per release",
      "description": "Look up retired person keys and their current successors or split candidates. Keys published in earlier releases carry forward here when groupings change.",
      "properties": [
        {
          "name": "old_person_key",
          "logicalType": "string",
          "physicalType": "VARCHAR",
          "customProperties": [
