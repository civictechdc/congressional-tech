      "content_date": null
    }
  },
  {
    "id": "html-instant-date-in-new-york",
    "parser": "html",
    "body": "<html><head><meta name=\"date\" content=\"2026-10-27T02:00:00Z\"></head><body><p>Published evidence.</p></body></html>",
