    "sample_basis": "https://help.proofpoint.com/Threat_Insight_Dashboard/API_Documentation/URL_Decoder_API paired encodedUrl/decodedUrl example; HTML entity decoding only, no API called"
  },
  {
    "id": "trackers",
    "kind": "strip",
    "host_pattern": null,
    "pattern": "(?i)^utm_.*$",
    "replacement": null,
    "decoder": null,
    "sample": "https://example.gov/a?utm_source=fixture",
