[
  {
    "id": "wayback",
    "kind": "wrapper",
    "host_pattern": null,
    "pattern": "(?i)^https?://web\\.archive\\.org/web/[0-9]{14}(?:[a-z]+_)?/(https?://.+)$",
    "replacement": "$1",
    "decoder": "none",
    "sample": "https://web.archive.org/web/20250610160415id_/https://example.gov/a.pdf",
    "sample_basis": "test_capture_url_admission.py timestamped replay"
  },
  {
    "id": "loc",
    "kind": "wrapper",
    "host_pattern": null,
    "pattern": "(?i)^https?://webarchive\\.loc\\.gov/all/[0-9]{14}(?:[a-z]+_)?/(https?://.+)$",
    "replacement": "$1",
    "decoder": "none",
    "sample": "https://webarchive.loc.gov/all/20110707213402/https://example.gov/a.pdf",
    "sample_basis": "test_capture_url_admission.py timestamped replay"
  },
  {
    "id": "proofpoint-v2",
