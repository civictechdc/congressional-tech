{
  "specVersion": "0.1",
  "kind": "policy",
  "id": "urn:congressional-tech:non-archive-workflows:scope",
  "version": "1.0.0",
  "rules": [
    {
      "id": "bls-index-grid-has-year",
      "check": "fields-exist",
      "dataset": "inflation/historical-grid",
      "fields": [
        "year"
      ]
    },
    {
      "id": "compatibility-parquet-only",
      "check": "vocabulary",
      "artifact": "committee-compatibility/export-parquet",
      "pointer": "/parameters/properties/format/enum",
      "allowed": [
        "parquet"
      ],
      "each": true
    }
  ]
}
