{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:house-naming:guide",
  "title": "House naming semantic catalog",
  "description": "Closed-object catalog schema. Run check_catalog as well for cross-reference, index and template integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "catalog_version",
    "document",
    "field_types",
    "patterns",
    "codes",
    "code_index",
    "examples",
    "example_index",
    "committees",
    "footnotes",
    "sections",
    "source_nodes",
    "policies",
    "extraction_rules",
    "extraction_vocabularies",
    "extraction_patterns",
    "extraction_roles"
  ],
  "properties": {
    "id": {
      "const": "house-document-naming"
    },
    "catalog_version": {
      "const": "3.0.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "version",
        "publication_date",
        "updated_date",
        "issuing_office",
        "issuing_unit",
        "page_count",
        "directory_congress",
        "pdf_sha256",
        "scope",
        "text_policy",
        "coverage",
        "provenance_policy",
        "omitted_content"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": "string",
          "minLength": 1
        },
        "updated_date": {
          "type": "string",
          "minLength": 1
        },
        "issuing_office": {
          "type": "string",
          "minLength": 1
        },
        "issuing_unit": {
          "type": "string",
          "minLength": 1
        },
        "page_count": {
          "const": 40
        },
        "directory_congress": {
          "const": 112,
          "description": "Congress represented by the retained historical committee/subcommittee directory; no member roster is included."
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "text_policy": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "provenance_policy": {
          "type": "string",
          "minLength": 1
        },
        "omitted_content": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content",
              "source_section",
              "first_page",
              "last_page",
              "reason"
            ],
            "properties": {
              "content": {
                "const": "member-directory"
              },
              "source_section": {
                "const": "section-46"
              },
              "first_page": {
                "const": 30
              },
              "last_page": {
                "const": 40
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "field_types": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/scalar"
          },
          {
            "$ref": "#/$defs/reference_array"
          }
        ]
      },
      "minProperties": 1
    },
    "patterns": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/pattern"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]+$"
      }
    },
    "codes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/code"
        },
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "minProperties": 1
    },
    "code_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "minProperties": 1
    },
    "examples": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/example"
      },
      "minProperties": 1
    },
    "example_index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "minProperties": 1
    },
    "committees": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "folder_code",
          "website",
          "indent",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "folder_code": {
            "type": "string",
            "minLength": 1
          },
          "website": {
            "type": [
              "string",
              "null"
            ]
          },
          "indent": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "minProperties": 1
    },
    "footnotes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "text",
          "source"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "minProperties": 1
    },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "page",
          "level",
          "parent_id",
          "child_ids",
          "source_ids",
          "conventions"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "child_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "conventions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/statement"
            },
            "minItems": 0
          }
        }
      },
      "minProperties": 1
    },
    "source_nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "page",
          "section_id",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "section",
              "row",
              "p",
              "item-body",
              "footnote"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "table_id": {
            "type": "string",
            "minLength": 1
          },
          "row_role": {
            "type": "string",
            "minLength": 1
          },
          "indent": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "minProperties": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "extraction_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pattern",
          "scope",
          "description",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "amendment-text-search",
              "appropriation-text-search",
              "collection-prefix",
              "committee-payload",
              "committee-print-search",
              "document-wording-search",
              "legislative-payload",
              "legislative-payload-search",
              "legislative-subject-search",
              "legislative-text-search",
              "meeting-suffix-search",
              "published-suffix-search",
              "report-text-search",
              "search",
              "stem",
              "transport-search",
              "unmatched-date",
              "unmatched-stem",
              "witness-suffix-search",
              "source-stem",
              "role-wording-search",
              "role-wording-prefix"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "Reading for a literal label capture, such as an explicit observed spelling alias; does not verify contents."
          },
          "field_readings": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/extraction_reading"
            },
            "description": "Static readings keyed by capture; computations may refine them while retaining raw text."
          },
          "source_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "description": "Exact publisher hostnames, consulted only by source-stem rules. No suffix matching or network request."
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https?://[^\\s]+$"
            },
            "description": "Exact caller-supplied source URLs qualifying reviewed local occurrences; never document identity."
          },
          "field_vocabularies": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "vocabulary"
                ],
                "properties": {
                  "vocabulary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "normalize": {
                    "enum": [
                      "words",
                      "first-word",
                      "letters"
                    ]
                  },
                  "fallback": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "searchable_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "scan_order": {
            "type": "integer",
            "minimum": 0
          },
          "reserve": {
            "type": "string",
            "minLength": 1
          },
          "reference_number": {
            "type": "string",
            "minLength": 1
          },
          "processors": {
            "type": "array",
            "items": {
              "enum": [
                "numeric-date",
                "congress-ordinal",
                "malformed-date",
                "fiscal-year",
                "inferred-version",
                "week-start",
                "partial-date",
                "possible-month-day",
                "month-year",
                "complete-date-token",
                "publication-components",
                "numeric-subject-parts",
                "capitalized-label-boundary",
                "following-degree",
                "between-degrees",
                "leading-date-label",
                "revision-date",
                "subject-remainder",
                "suffix-only-fallback",
                "atomic-identifier",
                "ascii-left-boundary",
                "avoid-ordinal-tail",
                "companion-context",
                "heading-abbreviation",
                "amendment-label-boundary",
                "report-description",
                "description-remainder",
                "measure-context"
              ]
            },
            "uniqueItems": true
          },
          "scan_stage": {
            "enum": [
              "context",
              "supplemental"
            ]
          },
          "whole_slot_only": {
            "type": "boolean"
          },
          "unique_refinement": {
            "type": "boolean"
          },
          "refine": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "stage",
                "mode"
              ],
              "oneOf": [
                {
                  "required": [
                    "rules"
                  ]
                },
                {
                  "required": [
                    "scope"
                  ]
                }
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "enum": [
                    "before-search",
                    "fields",
                    "match",
                    "scopes",
                    "targets",
                    "supplemental",
                    "local-reference"
                  ]
                },
                "mode": {
                  "enum": [
                    "search",
                    "match",
                    "fullmatch"
                  ]
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                },
                "scope": {
                  "enum": [
                    "amendment-text-search",
                    "appropriation-text-search",
                    "collection-prefix",
                    "committee-payload",
                    "committee-print-search",
                    "document-wording-search",
                    "legislative-payload",
                    "legislative-payload-search",
                    "legislative-subject-search",
                    "legislative-text-search",
                    "meeting-suffix-search",
                    "published-suffix-search",
                    "report-text-search",
                    "search",
                    "stem",
                    "transport-search",
                    "unmatched-date",
                    "unmatched-stem",
                    "witness-suffix-search",
                    "source-stem"
                  ]
                },
                "unique": {
                  "type": "boolean"
                },
                "search_rules": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "trim_for": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "when": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "values"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "minItems": 1
                    }
                  }
                }
              }
            }
          },
          "version_boundary_field": {
            "type": "string",
            "minLength": 1
          },
          "ordinal_tail": {
            "type": "string",
            "minLength": 1
          },
          "payload_scope": {
            "type": "string",
            "minLength": 1
          },
          "roster_congress": {
            "type": "string",
            "minLength": 1
          },
          "candidate_group": {
            "type": "string",
            "minLength": 1
          },
          "reserve_field": {
            "type": "string",
            "minLength": 1
          },
          "capture_rules": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          },
          "payload_probe": {
            "type": "boolean"
          },
          "leading_date": {
            "type": "boolean"
          },
          "revision_candidate": {
            "type": "boolean"
          },
          "unique_search": {
            "type": "boolean"
          },
          "unique_label": {
            "type": "boolean"
          },
          "respect_measure": {
            "type": "boolean"
          },
          "qualifier_anchor": {
            "type": "boolean"
          },
          "qualifier_before_only": {
            "type": "boolean"
          },
          "deduplicate_fields": {
            "enum": [
              "syntax",
              "reading"
            ]
          },
          "allow_overlap_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "publication_components": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "numbered_markers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "reading": {
                "$ref": "#/$defs/extraction_reading"
              },
              "field_vocabularies": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "vocabulary"
                    ],
                    "properties": {
                      "vocabulary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from": {
                        "type": "string",
                        "minLength": 1
                      },
                      "normalize": {
                        "enum": [
                          "words",
                          "first-word",
                          "letters"
                        ]
                      },
                      "fallback": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extraction_vocabularies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/extraction_reading"
        }
      }
    },
    "extraction_patterns": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern"
        ],
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "vocabularies": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "context"
              ],
              "properties": {
                "context": {
                  "type": "string",
                  "minLength": 1
                },
                "extra": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "ignore_case": {
            "type": "boolean"
          }
        }
      }
    },
    "extraction_roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "page"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer"
          ]
        },
        "description": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "uri"
          ]
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "const": {
          "type": [
            "integer",
            "string"
          ]
        },
        "enum": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "not": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "default": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "action",
        "fields",
        "required",
        "requires_interpretation",
        "decisions",
        "sources",
        "conventions",
        "footnote_ids",
        "source_example_ids",
        "source_examples_relation"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "filename",
            "reference"
          ]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "requires_interpretation": {
          "type": "boolean"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0
        },
        "conventions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "minItems": 0
        },
        "footnote_ids": {
          "type": "array",
          "items": {
            "type": "string",
