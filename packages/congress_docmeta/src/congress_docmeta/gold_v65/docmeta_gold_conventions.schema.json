{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "docmeta_gold_conventions.schema.json",
 "title": "DocMeta gold conventions overlay (V6.5 House Conventions)",
 "description": "Overlay on docmeta_v4_causal.schema.json: conventions decidable from the label alone. A label must pass the base schema (validate_docmeta_v4) AND this overlay. Each $defs entry is one rule: its key is the rule id, `x-severity` is error (trainer and scorer refuse the dataset) or warn, `$comment` names the rubric sentence. gold_contract.py maps each validation error to its rule through allOf[i].",
 "x-contract-version": "docmeta-gold-contract/2",
 "$defs": {
  "L10_nonusable_no_kind": {
   "x-severity": "error",
   "$comment": "Rubric: `primary_kind` (required when status == \"usable\"); non-usable statuses carry triage or masthead fields only.",
   "description": "A status other than usable carries no primary_kind and no secondary_kinds.",
   "if": {
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "not": {
       "const": "usable"
      }
     }
    }
   },
   "then": {
    "properties": {
     "primary_kind": false,
     "secondary_kinds": false
    }
   },
   "x-blind": "Whether the status itself is right."
  },
  "L11_usable_has_kind_and_tail": {
   "x-severity": "error",
   "$comment": "Rubric: `primary_kind` (required when status == \"usable\"); Required Synthesis Tail on Every `usable` Document: composed_title, gist, topics.",
   "description": "A usable label has primary_kind, composed_title, gist and topics.",
   "if": {
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "const": "usable"
     }
    }
   },
   "then": {
    "required": [
     "primary_kind",
     "composed_title",
     "gist",
     "topics"
    ]
   },
   "x-blind": "Whether the kind, title, gist and topics are right."
  },
  "L12_error_status_triage_only": {
   "x-severity": "error",
   "$comment": "Rubric: Hard-Error / Unusable Triage Statuses (`error_reason` REQUIRED; omit ALL other fields!).",
   "description": "error_or_block, stub_or_blank and ocr_unreadable carry exactly status, text_quality and error_reason.",
   "if": {
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "enum": [
       "error_or_block",
       "stub_or_blank",
       "ocr_unreadable"
      ]
     }
    }
   },
   "then": {
    "required": [
     "error_reason"
    ],
    "propertyNames": {
     "enum": [
      "status",
      "text_quality",
      "error_reason"
     ]
    }
   },
   "x-blind": "Whether the triage status is right."
  },
  "L13_error_reason_only_on_error_status": {
   "x-severity": "error",
   "$comment": "Rubric: Structural Wrapper / Listing Non-Usable Statuses (NO `error_reason`); schema: error_reason populated ONLY when status is error_or_block, stub_or_blank, or ocr_unreadable.",
   "description": "error_reason appears only with the three triage statuses.",
   "if": {
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "not": {
       "enum": [
        "error_or_block",
        "stub_or_blank",
        "ocr_unreadable"
       ]
      }
     }
    }
   },
   "then": {
    "properties": {
     "error_reason": false
    }
   },
   "x-blind": "Whether the status is right."
  },
