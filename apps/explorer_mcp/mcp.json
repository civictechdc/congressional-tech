{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "congress": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--from",
        "congressional-explorer-mcp==0.5.0",
        "congress-explorer-mcp",
        "serve",
        "--prepare-if-missing"
      ],
      "env": {
        "PATH": "${HOME}/.local/bin:${HOME}/.cargo/bin:${HOME}/.pyenv/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  }
}
