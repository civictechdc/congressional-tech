---
import { withBase } from '../lib/paths';

interface Props {
  active?: string;
}

const { active } = Astro.props;

const links = [
  { key: 'home', label: 'Home', href: withBase('/') },
  { key: 'proposals', label: 'Proposals', href: withBase('/proposals/') },
  { key: 'projects', label: 'Projects', href: withBase('/projects/') },
  { key: 'dashboard', label: 'YouTube Coverage', href: withBase('/dashboard/') },
  { key: 'contribute', label: 'Contribute', href: withBase('/contribute/') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-eyebrow eyebrow">Civic Tech DC</span>
      <span class="brand-name">Congressional Tech</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a
                class:list={['nav-link', { 'is-active': active === link.key }]}
                href={link.href}
                aria-current={active === link.key ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="nav-link nav-link--github"
            href="https://github.com/civictechdc/congressional-tech"
          >
            <svg
              class="github-mark"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            GitHub
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Dark glass anchor: midnight backing + blur + hairline bottom border */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 26, 48, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ctdc-hairline-on-dark);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--ctdc-space-2xs) var(--ctdc-space-lg);
    padding-block: var(--ctdc-space-xs);
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .brand-eyebrow {
    color: var(--ctdc-gold);
  }

  .brand-name {
    font-size: var(--ctdc-text-lg);
    font-weight: var(--ctdc-weight-bold);
    letter-spacing: var(--ctdc-tracking-tight);
    color: var(--ctdc-on-dark-strong);
    transition: color var(--ctdc-duration-fast) var(--ctdc-ease);
  }

  .brand:hover .brand-name {
    color: var(--ctdc-gold);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ctdc-space-3xs) var(--ctdc-space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: var(--ctdc-space-2xs) var(--ctdc-space-3xs);
    font-size: var(--ctdc-text-sm);
    font-weight: var(--ctdc-weight-semibold);
    text-decoration: none;
    color: var(--ctdc-on-dark);
    /* Thin gold underline reserved for the active page (vision.md) */
    border-bottom: 2px solid transparent;
    transition:
      color var(--ctdc-duration-fast) var(--ctdc-ease),
      transform var(--ctdc-duration-fast) var(--ctdc-ease);
  }

  .nav-link:hover {
    color: var(--ctdc-gold);
    transform: translateY(-3px);
  }

  .nav-link.is-active {
    color: var(--ctdc-on-dark-strong);
    border-bottom-color: var(--ctdc-gold);
  }

  .nav-link--github {
    display: inline-flex;
    align-items: center;
    gap: var(--ctdc-space-2xs);
  }

  .github-mark {
    flex: none;
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
