---
interface Props { command: string; label?: string; instructionsHref?: string }
const { command, label = 'Copy command', instructionsHref } = Astro.props;
---
<div class:list={['copy-command', { 'copy-instructions': instructionsHref }]}>
  {!instructionsHref && <pre><code>{command}</code></pre>}
  <button type="button" data-copy={command} data-instructions={instructionsHref} aria-label={label} hidden>{instructionsHref ? label : 'Copy'}</button>
  {instructionsHref && <a href={instructionsHref}>Instructions for AI assistants (Markdown)</a>}
  <span class="copy-status" role="status"></span>
</div>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector('.copy-status');
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (status) status.textContent = button.dataset.instructions ? 'Copied. Paste this into a conversation with your AI assistant.' : 'Copied';
      } catch {
        if (status) status.textContent = button.dataset.instructions ? 'Open “Instructions for AI assistants” to copy the text yourself.' : 'Select the command and copy it manually.';
      }
    });
  }
</script>
<style>
  .copy-command { position: relative; min-width: 0; }
  pre { margin: .8rem 0; padding: 1.2rem 5.5rem 1.2rem 1.2rem; line-height: 1.7; }
  button { position: absolute; right: .6rem; top: .6rem; padding: .5rem .7rem; background: transparent; color: var(--ctdc-gold); border: 1px solid var(--ctdc-on-dark-caption); border-radius: 4px; cursor: pointer; font: inherit; font-size: .85rem; transition: background .2s; }
  button:hover { background: var(--ctdc-primary); }
  button:focus-visible { outline-color: var(--ctdc-gold); }
  .copy-status { display: block; min-height: 1.4em; font-size: .85rem; color: var(--ctdc-ink-muted); }
  .copy-instructions button { position: static; display: block; margin: .8rem 0; padding: .7rem 1rem; background: var(--ctdc-primary); color: var(--ctdc-on-dark-strong); border-color: var(--ctdc-primary); font-size: 1rem; }
  .copy-instructions button:hover { background: var(--ctdc-primary-hover); }
  .copy-instructions button:focus-visible { outline-color: var(--ctdc-primary); }
  .copy-instructions a { font-size: .9rem; }
</style>
