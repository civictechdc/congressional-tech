---
/**
 * Decorative hero art: a gold-line architectural elevation of the Capitol,
 * drawn in the Civic Premium Dark language (hairline gold strokes on the
 * midnight anchor). Replaces the old raster clip-art banner — no baked-in
 * text, no icon soup, crisp at every size.
 */
---

<svg
  class="capitol-art"
  viewBox="0 0 900 620"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- halo arcs radiating from the dome -->
  <g class="art-halo">
    <circle cx="450" cy="200" r="150"></circle>
    <circle cx="450" cy="200" r="215"></circle>
    <circle cx="450" cy="200" r="285"></circle>
  </g>

  <!-- scattered data points -->
  <g class="art-dot">
    <circle cx="240" cy="215" r="2"></circle>
    <circle cx="300" cy="148" r="1.5"></circle>
    <circle cx="180" cy="320" r="2"></circle>
    <circle cx="660" cy="178" r="2.5"></circle>
    <circle cx="702" cy="262" r="1.5"></circle>
    <circle cx="760" cy="378" r="1.5"></circle>
  </g>

  <!-- primary structure -->
  <g class="art-main">
    <!-- statue + tholos (lantern) -->
    <circle cx="450" cy="134" r="2.5"></circle>
    <path d="M450 138 L450 150"></path>
    <path d="M433 165 Q450 149 467 165"></path>
    <path d="M433 165 L467 165"></path>
    <path d="M433 192 L467 192"></path>

    <!-- dome -->
    <path d="M398 300 A52 106 0 0 1 502 300"></path>
    <path d="M396 300 L504 300"></path>
    <path d="M392 306 L508 306"></path>

    <!-- upper drum -->
    <path d="M415 330 L415 306"></path>
    <path d="M485 330 L485 306"></path>
    <path d="M412 330 L488 330"></path>

    <!-- lower drum (peristyle) -->
    <path d="M400 395 L400 330"></path>
    <path d="M500 395 L500 330"></path>
    <path d="M396 395 L504 395"></path>

    <!-- attic story -->
    <path d="M380 430 L380 395 L520 395 L520 430"></path>

    <!-- center block -->
    <path d="M330 560 L330 430 L570 430 L570 560"></path>
    <path d="M330 445 L570 445"></path>

    <!-- pediment + portico -->
    <path d="M350 460 L450 417 L550 460 L350 460"></path>
    <path d="M370 545 L530 545"></path>

    <!-- wings -->
    <path d="M80 560 L80 460 L280 460"></path>
    <path d="M280 560 L280 460"></path>
    <path d="M80 475 L280 475"></path>
    <path d="M820 560 L820 460 L620 460"></path>
    <path d="M620 560 L620 460"></path>
    <path d="M620 475 L820 475"></path>

    <!-- connecting corridors -->
    <path d="M280 490 L330 490"></path>
    <path d="M570 490 L620 490"></path>

    <!-- terrace + steps + ground -->
    <path d="M60 560 L840 560"></path>
    <path d="M368 575 L532 575"></path>
    <path d="M354 590 L546 590"></path>
    <path d="M40 604 L860 604"></path>
  </g>

  <!-- fine detail: ribs, colonnades, pilasters -->
  <g class="art-detail">
    <!-- dome ribs + rings -->
    <path d="M416 299 Q417 230 448 201"></path>
    <path d="M484 299 Q483 230 452 201"></path>
    <path d="M433 299 Q434 226 449 200"></path>
    <path d="M467 299 Q466 226 451 200"></path>
    <path d="M406 272 Q450 258 494 272"></path>
    <path d="M415 240 Q450 228 485 240"></path>

    <!-- upper drum windows -->
    <path d="M426 326 L426 309"></path>
    <path d="M438 326 L438 309"></path>
    <path d="M450 326 L450 309"></path>
    <path d="M462 326 L462 309"></path>
    <path d="M474 326 L474 309"></path>

    <!-- peristyle columns -->
    <path d="M405 390 L405 335"></path>
    <path d="M414 390 L414 335"></path>
    <path d="M423 390 L423 335"></path>
    <path d="M432 390 L432 335"></path>
    <path d="M441 390 L441 335"></path>
    <path d="M450 390 L450 335"></path>
    <path d="M459 390 L459 335"></path>
    <path d="M468 390 L468 335"></path>
    <path d="M477 390 L477 335"></path>
    <path d="M486 390 L486 335"></path>
    <path d="M495 390 L495 335"></path>

    <!-- attic pilasters -->
    <path d="M398 425 L398 400"></path>
    <path d="M424 425 L424 400"></path>
    <path d="M450 425 L450 400"></path>
    <path d="M476 425 L476 400"></path>
    <path d="M502 425 L502 400"></path>

    <!-- portico columns -->
    <path d="M362 545 L362 462"></path>
    <path d="M387 545 L387 462"></path>
    <path d="M412 545 L412 462"></path>
    <path d="M437 545 L437 462"></path>
    <path d="M462 545 L462 462"></path>
    <path d="M487 545 L487 462"></path>
    <path d="M512 545 L512 462"></path>
    <path d="M537 545 L537 462"></path>

    <!-- inner pediment line -->
    <path d="M364 457 L450 420 L536 457"></path>

    <!-- wing pilasters + string courses -->
    <path d="M100 545 L100 480"></path>
    <path d="M120 545 L120 480"></path>
    <path d="M140 545 L140 480"></path>
    <path d="M160 545 L160 480"></path>
    <path d="M180 545 L180 480"></path>
    <path d="M200 545 L200 480"></path>
    <path d="M220 545 L220 480"></path>
    <path d="M240 545 L240 480"></path>
    <path d="M260 545 L260 480"></path>
    <path d="M95 512 L265 512"></path>
    <path d="M640 545 L640 480"></path>
    <path d="M660 545 L660 480"></path>
    <path d="M680 545 L680 480"></path>
    <path d="M700 545 L700 480"></path>
    <path d="M720 545 L720 480"></path>
    <path d="M740 545 L740 480"></path>
    <path d="M760 545 L760 480"></path>
    <path d="M780 545 L780 480"></path>
    <path d="M800 545 L800 480"></path>
    <path d="M635 512 L805 512"></path>

    <!-- corridor pilasters -->
    <path d="M292 555 L292 498"></path>
    <path d="M306 555 L306 498"></path>
    <path d="M320 555 L320 498"></path>
    <path d="M580 555 L580 498"></path>
    <path d="M594 555 L594 498"></path>
    <path d="M608 555 L608 498"></path>
  </g>
</svg>

<style>
  .capitol-art {
    display: block;
    width: 100%;
    height: auto;
  }

  .art-main {
    stroke: rgba(238, 192, 94, 0.55);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .art-detail {
    stroke: rgba(238, 192, 94, 0.26);
    stroke-width: 1;
    stroke-linecap: round;
  }

  .art-halo {
    stroke: rgba(238, 192, 94, 0.06);
    stroke-width: 1;
  }

  .art-dot circle {
    fill: rgba(238, 192, 94, 0.32);
  }
</style>
