---
import Base from '../layouts/Base.astro';
import Explorer from '../components/explorer/Explorer';
import { withBase } from '../lib/paths';
import '../styles/explorer.css';
---

<Base title="Committee Explorer" active="dashboard" description="Explore congressional committee meetings, recordings, documents, witnesses, source evidence, and known gaps.">
  <section class="explorer-page">
    <div class="container">
      <div class="explorer-page-heading">
        <div><p class="eyebrow">Committee records</p><h1>Committee Explorer</h1></div>
        <div class="explorer-page-links">
          <a href={withBase('/mcp/')}>Use this data with your AI assistant</a>
          <span class="explorer-page-sep" aria-hidden="true">·</span>
          <a href={withBase('/archive/')}>Browse 367,000+ preserved hearing documents in the Document Archive</a>
        </div>
      </div>
      <Explorer pointerUrl={withBase('/data/explorer/CURRENT.json')} client:load />
      <noscript><p>The interactive explorer requires JavaScript. Browse the <a href="https://github.com/civictechdc/congressional-tech/tree/pipeline-data">retained source data</a> on GitHub.</p></noscript>
    </div>
  </section>
</Base>
