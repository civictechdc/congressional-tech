---
import Base from '../layouts/Base.astro';
import Dashboard from '../components/dashboard/Dashboard';
import '../styles/dashboard.css';
---

<Base
  title="YouTube Coverage"
  active="dashboard"
  description="How consistently congressional committees tag their YouTube videos with official Event IDs, by congress, chamber, and party control."
>
  <section class="page-hero anchor-dark">
    <div class="container">
      <p class="eyebrow page-eyebrow">Project I.2 · Live data</p>
      <h1 class="page-title">Committee YouTube coverage</h1>
      <p class="page-lead lead">
        Committees publish thousands of hearing videos, but many never include
        the official Event ID that links a video back to the record on
        Congress.gov. This dashboard tracks that gap.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Dashboard client:visible />
      <p class="dash-footnote">
        Data: <code>youtube_event_id_report.csv</code>, generated by
        <a
          href="https://github.com/civictechdc/congressional-tech/tree/main/apps/committee_youtube"
        >
          apps/committee_youtube</a
        >. Party control per congress from the repo's congress metadata.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    padding-block: var(--ctdc-space-3xl);
  }

  .page-eyebrow {
    color: var(--ctdc-gold);
    margin-bottom: var(--ctdc-space-2xs);
  }

  .page-title {
    font-size: var(--ctdc-text-3xl);
    margin-bottom: var(--ctdc-space-xs);
  }

  .page-lead {
    color: var(--ctdc-on-dark);
    max-width: 44rem;
    margin: 0;
  }

  .dash-footnote {
    margin-top: var(--ctdc-space-lg);
    font-size: var(--ctdc-text-xs);
    color: var(--ctdc-ink-muted);
  }
</style>
