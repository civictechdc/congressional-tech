---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
---

<Base title="Committee Explorer has moved" description="Browse congressional records in Congress Explorer.">
  <section class="section">
    <div class="container">
      <h1>Committee Explorer has moved</h1>
      <p id="dashboard-move-note" role="status">Congress Explorer brings committee records and the document archive together.</p>
      <a id="dashboard-destination" href={withBase('/archive/?tab=hearings')}>Open Congress Explorer</a>
    </div>
  </section>
</Base>

<script>
  import { withBase } from '../lib/paths';

  const tabs = new Map([
    ['committees', 'committees'],
    ['materials', 'documents'],
    ['witnesses', 'witnesses'],
  ]);

  function forwardBookmark() {
    const previous = new URLSearchParams(location.search);
    const view = previous.get('view');
    const kind = previous.get('kind');
    const id = previous.get('id')?.trim();
    const hearing = (previous.get('hearing') || previous.get('meeting') || previous.get('event_id'))?.trim();
    const tab = hearing || kind === 'meeting' ? 'hearings' : tabs.get(view ?? '') ?? 'hearings';
    const destination = new URL(withBase('/archive/'), location.origin);
    if (tab !== 'documents') destination.searchParams.set('tab', tab);
    const { searchParams } = destination;
    const q = previous.get('q');
    const congress = previous.get('congress');
    const chamber = previous.get('chamber');
    const committee = previous.get('committee');
    if (q) searchParams.set('q', q);
    if (congress && /^\d+$/.test(congress)) searchParams.set('congress', congress);
    if (chamber && ['hearings', 'committees'].includes(tab)) searchParams.set('chamber', chamber);
    if (committee && /^[a-z]{4}\d{2}$/i.test(committee)) searchParams.set('committee', committee);
    destination.hash = location.hash;

    const link = document.querySelector<HTMLAnchorElement>('#dashboard-destination')!;
    const note = document.getElementById('dashboard-move-note')!;
    link.href = destination.href;
    if (hearing) {
      searchParams.set('hearing', hearing);
    } else if (view === 'coverage' || view === 'gaps') {
      note.textContent = 'The former Coverage and Gaps views have closed. Open a hearing to see its available sources and evidence.';
      return;
    } else if (id) {
      note.textContent = 'This old Committee Explorer record link has been removed. Open Congress Explorer to search the current release.';
      return;
    }
    location.replace(destination.href);
  }

  forwardBookmark();
</script>
