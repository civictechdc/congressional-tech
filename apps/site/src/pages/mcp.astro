---
import Base from '../layouts/Base.astro';
import CapitolArt from '../components/CapitolArt.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { withBase } from '../lib/paths';
import { release, repository, remoteMcp, releaseUrl, pypiUrl, desktopBundle, pluginBundle, webPluginBundle, codexSetup, claudeSetup, skillSetup, install, agentInstructions, setupDocs } from '../lib/mcp-setup';

const instructionsHref = withBase('/mcp/agent.md');
const exploreLink = `codex://new?prompt=${encodeURIComponent('[@Congress Explorer](plugin://congress-explorer@congressional-tech) Find hearings about artificial intelligence and list their witnesses and organizations.')}`;
const clients = [
  { id: 'claude-desktop', name: 'Claude Desktop', destination: 'Settings → Developer → Edit Config', detail: 'Merge the printed congress entry into mcpServers in your configuration. Keep your existing servers. Quit and reopen Claude Desktop.', url: 'https://modelcontextprotocol.io/docs/develop/connect-local-servers' },
  { id: 'codex', name: 'Codex', destination: '~/.codex/config.toml', detail: 'Add the printed [mcp_servers.congress] section to your config file. Replace an existing congress section rather than adding a duplicate. Restart the client connection.', url: 'https://developers.openai.com/codex/mcp/' },
  { id: 'cursor', name: 'Cursor', destination: '~/.cursor/mcp.json', detail: 'Merge the printed congress entry into mcpServers in your configuration. Keep your existing servers. Enable Congress in Cursor’s MCP settings.', url: 'https://cursor.com/docs/mcp' },
  { id: 'claude-code', name: 'Claude Code', destination: 'A new terminal session', detail: 'Save the printed JSON to a file, then start Claude Code with --mcp-config /absolute/path/to/that-file.json. Review the requested tool permissions.', url: 'https://code.claude.com/docs/en/mcp' },
];
const prompts = [
  'Find documents related to H.R. 1 in the 119th Congress. Group them by hearing.',
  'Find hearings about artificial intelligence and list their witnesses and organizations.',
  'Find recordings and saved transcripts for a committee meeting I choose.',
];
---
<Base title="Congress Explorer MCP — Use with AI" active="mcp" description="Ask your AI assistant about congressional hearings, witnesses, bills, members and related documents. Set up Claude or Codex on desktop, or Claude or ChatGPT in your browser.">
  <link slot="head" rel="alternate" type="text/markdown" title="Instructions for AI assistants" href={instructionsHref} />
  <section class="mcp-hero anchor-dark">
    <div class="mcp-art" aria-hidden="true"><CapitolArt /></div>
    <div class="container mcp-hero-content">
      <p class="eyebrow">Congressional Tech · Use with AI</p>
      <h1>Congress Explorer <span>MCP</span></h1>
      <p class="mcp-lead">Congressional data.<br />Your questions. Your assistant.</p>
      <p class="mcp-intro">Find hearings, witnesses, bills, members, recordings, and related documents through your AI assistant.</p>
      <nav class="setup-choices" aria-label="Choose your setup">
        <div>
          <h2>Desktop apps</h2>
          <div class="mcp-actions">
            <a class="btn btn--gold" href="#claude-desktop">Claude desktop</a>
            <a class="btn btn--gold" href="#codex-desktop">Codex desktop</a>
          </div>
        </div>
        <div>
          <h2>Web browsers</h2>
          <div class="mcp-actions">
            <a class="btn btn--gold" href="#claude-web">Claude web</a>
            <a class="btn btn--gold" href="#chatgpt-web">ChatGPT web</a>
          </div>
        </div>
      </nav>
      <p class="mcp-platforms">Version {release.version} · Free &amp; open source · Use in your browser or on macOS and Linux</p>
    </div>
  </section>

  <section class="section" id="plugins">
    <div class="container mcp-layout">
      <div>
        <p class="eyebrow">Quick setup</p>
        <h2>Choose your<br />AI assistant.</h2>
        <p>Connect Congress Explorer using the steps for your app, then ask a question in your own words.</p>
        <p class="mcp-note">Browser setup needs no downloads. Desktop setup is available for macOS and Linux. On Windows, choose one of the web options.</p>
        <p>Want help setting up? Give these instructions to your AI assistant.</p>
        <CopyCommand command={agentInstructions} label="Copy for my AI assistant" instructionsHref={instructionsHref} />
        <a href="#setup">Other apps &amp; manual setup ↓</a>
        <p class="mcp-note setup-reviewed">Instructions checked against the official guides on <time datetime="2026-11-05">November 5, 2026</time>.</p>
      </div>
      <div class="mcp-steps">
        <section class="setup-group" aria-labelledby="desktop-heading">
          <h2 id="desktop-heading">Desktop apps</h2>
          <p class="mcp-note">Install Congress Explorer on your computer. These downloads support macOS and Linux.</p>
          <section class="mcp-step" id="claude-extension-heading" aria-labelledby="claude-desktop">
            <h3 id="claude-desktop" tabindex="-1">Claude desktop</h3>
            <ol class="setup-list">
              <li>Download the Congress Explorer extension below.</li>
              <li>In Claude Desktop, open <strong>Settings → Desktop app</strong> and select <strong>Manage</strong> next to <strong>Extensions</strong>.</li>
              <li>Open <strong>Advanced settings → Install Extension…</strong>, select the downloaded file, and follow the installation prompts.</li>
              <li>Start a chat. Open <strong>+ → Connectors</strong> to check that Congress Explorer is available, then ask a question.</li>
            </ol>
            <a class="btn btn--gold" href={desktopBundle}>Download Claude Desktop extension</a>
            <p class="mcp-note">Use the latest Claude Desktop. In older layouts, look for <strong>Settings → Extensions</strong>. <a href={setupDocs.claudeDesktop}>Official Claude desktop guide ↗</a></p>
          </section>
          <section class="mcp-step" id="openai-plugin-heading" aria-labelledby="codex-desktop">
            <h3 id="codex-desktop" tabindex="-1">Codex desktop</h3>
            <ol class="setup-list">
              <li>Install <a href="https://docs.astral.sh/uv/getting-started/installation/">uv</a> and the <a href="https://developers.openai.com/codex/cli/">Codex command-line app</a>. These handle the one-time setup.</li>
              <li>Paste these commands into a terminal:
                <CopyCommand command={codexSetup} label="Copy Codex desktop setup commands" />
              </li>
              <li>Open Codex in the ChatGPT desktop app and start a new local conversation.</li>
              <li>Type <strong>@</strong>, select <strong>Congress Explorer</strong>, and ask a question.</li>
            </ol>
            <a class="btn btn--gold" href={exploreLink}>Open a question in Codex</a>
            <p class="mcp-note">The commands install Congress Explorer from our GitHub project. The button prepares a question for you to review and send. <a href={setupDocs.codex}>Official Codex plugin guide ↗</a> · <a href={setupDocs.codexMarketplace}>Setup command reference ↗</a></p>
          </section>
        </section>
        <section class="setup-group" aria-labelledby="web-heading">
          <h2 id="web-heading">Web browsers</h2>
          <p class="mcp-note">Connect online without installing software on your computer. The first connection may take a moment.</p>
          <section class="mcp-step" aria-labelledby="claude-web">
            <h3 id="claude-web" tabindex="-1">Claude web</h3>
            <ol class="setup-list">
              <li>In <a href="https://claude.ai/">Claude</a>, open <strong>Customize → Connectors</strong>. Choose <strong>Add → Custom → Web</strong>, or <strong>Add custom connector</strong> if that is the option shown.</li>
              <li>Name it <strong>Congress Explorer</strong>. Paste this address and select <strong>Continue</strong>:
                <CopyCommand command={remoteMcp} label="Copy address for Claude web" />
              </li>
              <li>Continue through the settings, choosing <strong>No sign in</strong> under Authentication. You do not need an API key. Select <strong>Add</strong> to finish.</li>
              <li>Start a chat, open <strong>+ → Connectors</strong>, and turn on Congress Explorer.</li>
            </ol>
            <p class="mcp-note">For a work account, an organization owner may need to add the connector first. <a href={setupDocs.claudeWeb}>Official Claude custom connector guide ↗</a> · <a href={setupDocs.claudeConnectors}>Connector menu guide ↗</a></p>
          </section>
          <section class="mcp-step" id="web-plugin-heading" aria-labelledby="chatgpt-web">
            <h3 id="chatgpt-web" tabindex="-1">ChatGPT web</h3>
            <ol class="setup-list">
              <li>Open <a href="https://chatgpt.com/plugins">ChatGPT Plugins</a>. Select <strong>+ → Add custom MCP server</strong>.</li>
              <li>Name it <strong>Congress Explorer Web</strong>. Under Connection, paste this server address:
                <CopyCommand command={remoteMcp} label="Copy address for ChatGPT web" />
              </li>
              <li>Choose <strong>No authentication</strong>. Review and acknowledge the warning, then select <strong>Create as a plugin</strong>.</li>
              <li>Review the available tools and install the plugin. Start a new conversation, type <strong>@</strong>, and select <strong>Congress Explorer Web</strong>.</li>
            </ol>
            <p class="mcp-note">If the option is unavailable, check your account or workspace permissions. <a href={setupDocs.chatgpt}>Official ChatGPT setup guide ↗</a></p>
          </section>
        </section>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="setup">
    <div class="container">
    <details class="manual-setup">
    <summary>Other apps &amp; manual setup</summary>
    <div class="mcp-layout">
      <aside class="mcp-orientation">
        <p class="eyebrow">Manual setup</p>
        <h2>Set up another app.</h2>
        <p>These steps install Congress Explorer on your computer and connect it to your chosen AI app.</p>
        <p>Your app starts Congress Explorer when you need it. After setup, you can close the terminal.</p>
        <a href={releaseUrl}>Release {release.version} &amp; source code ↗</a>
      </aside>
      <div class="mcp-steps">
        <section class="mcp-step" aria-labelledby="claude-plugin-heading">
          <h3 id="claude-plugin-heading">Claude Code &amp; Cowork</h3>
          <p>For Claude Code, install <a href="https://docs.astral.sh/uv/getting-started/installation/">uv</a>, then paste this command into a terminal:</p>
          <CopyCommand command={claudeSetup} label="Copy Claude plugin install command" />
          <p>In Cowork desktop, open Customize → Plugins and upload the plugin ZIP. Start a local task, then run <code>/congress-explorer:explore-congress</code>.</p>
          <a class="btn btn--gold" href={pluginBundle}>Download plugin ZIP</a>
          <p class="mcp-note">For Claude Desktop chat, follow the <a href="#claude-desktop">Claude desktop instructions</a>.</p>
        </section>
        <section class="mcp-step" aria-labelledby="install-heading">
          <p class="step-number">01 / Install</p>
          <h3 id="install-heading">Install Congress Explorer</h3>
          <p>Install <a href="https://docs.astral.sh/uv/getting-started/installation/">uv</a>, then paste this command into a terminal. It downloads <a href={pypiUrl}>Congress Explorer</a> and the software it needs.</p>
          <CopyCommand command={install} label="Copy install command" />
          <p class="mcp-note">If you see “command not found” afterward, run <code>uv tool update-shell</code> and open a new terminal. Desktop installation requires macOS or Linux.</p>
        </section>
        <section class="mcp-step" aria-labelledby="prepare-heading">
          <p class="step-number">02 / Prepare</p>
          <h3 id="prepare-heading">Download the data and check it</h3>
          <CopyCommand command={'congress-explorer-mcp prepare\ncongress-explorer-mcp check'} label="Copy prepare and check commands" />
          <p>Look for <code>"status": "ok"</code> in the result. This confirms that Congress Explorer can connect and read the data.</p>
          <p class="mcp-note">Congress Explorer saves a copy of the records on your computer. Individual documents download when you ask to read them.</p>
        </section>
        <section class="mcp-step" aria-labelledby="connect-heading">
          <p class="step-number">03 / Connect</p>
          <h3 id="connect-heading">Choose your assistant</h3>
          <div id="client-picker" hidden>
            <label for="mcp-client">Your AI app</label>
            <select id="mcp-client" aria-controls="client-instructions">
              {clients.map(client => <option value={client.id}>{client.name}</option>)}
            </select>
          </div>
          <div id="client-instructions">
            {clients.map(client => <section class="client-guide" data-client={client.id} aria-label={`${client.name} setup`}>
              <h4>{client.name}</h4>
              <CopyCommand command={`congress-explorer-mcp config --client ${client.id}`} label={`Copy ${client.name} configuration command`} />
              <p><strong>{client.destination}</strong></p>
              <p>{client.detail}</p>
              <p class="mcp-note">Copy the settings printed by the command into your app. <a href={client.url}>App setup guide ↗</a></p>
            </section>)}
          </div>
        </section>
        <section class="mcp-step" aria-labelledby="skill-heading">
          <h3 id="skill-heading">Optional instructions for your assistant</h3>
          <p>The plugin already includes research guidance. To add just that guidance to another assistant that supports skills, use Node.js 22.20 or later and run:</p>
          <CopyCommand command={skillSetup} label="Copy research skill install command" />
          <p>Choose your assistant, then ask it to use <code>explore-congress</code>. You still need to connect Congress Explorer to search the data. <a href="https://github.com/vercel-labs/skills/blob/main/docs/commands.md#skills-add">Skill installation guide ↗</a></p>
          <p>If your app asks you to upload a plugin file for the web connection, <a href={webPluginBundle}>download the web plugin ZIP</a>. It includes both the connection settings and research guidance.</p>
        </section>
      </div>
    </div>
    </details>
    </div>
  </section>

  <section class="section section--tint" id="try-it">
    <div class="container mcp-layout">
      <div><p class="eyebrow">Start a conversation</p><h2>Follow a question<br />through Congress.</h2><p>Ask your assistant to use Congress Explorer to find records, connect related hearings and people, and read documents.</p></div>
      <div class="mcp-prompts">{prompts.map((prompt, index) => <div class="mcp-prompt"><span aria-hidden="true">0{index + 1}</span><p>“{prompt}”</p></div>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="container mcp-layout">
      <div><p class="eyebrow">Know your data</p><h2>Published records.<br />Clear boundaries.</h2></div>
      <div class="mcp-details">
        <details open><summary>What can I explore?</summary><p>Hearings, witnesses, bills, nominations, members, committees, recordings, and related documents. Coverage varies by source and time period. Some records are missing, so an empty search does not mean an event never happened.</p></details>
        <details><summary>Can it read documents?</summary><p>Yes. Ask your assistant to find a document, then read or search its text. Some scanned documents contain only page images, so their text may be unavailable. You can search document details and the text of individual documents. Searching the text of every document at once is not supported.</p></details>
        <details><summary>How do I get newer data?</summary><p>For either web connection, we manage the data updates. With a desktop installation, ask your assistant to help refresh your downloaded records using the <a href={instructionsHref}>setup instructions</a>. To update the Congress Explorer software itself, install the latest version linked on this page and restart your app.</p></details>
        <details><summary>What leaves my computer?</summary><p>Browser connections send your searches to our service, hosted by Cloudflare. Desktop installations search a copy of the records on your computer. In either case, your AI app may share your questions and results with its AI provider. Reading documents requires an internet connection.</p></details>
        <details><summary>Need help connecting?</summary><p>For a web connection, check that you copied the full address. Choose <strong>No sign in</strong> in Claude or <strong>No authentication</strong> in ChatGPT. If the connection fails, wait a moment and try again. For help with desktop setup, use <strong>Copy for my AI assistant</strong> above and paste the instructions into a conversation. You can also <a href={`${repository}/issues`}>report a problem</a>; include your app's name and the error message you see.</p></details>
        <p class="mcp-more"><a href={`${repository}/tree/main/apps/explorer_mcp`}>Technical documentation ↗</a><a href={withBase('/archive/')}>Browse the data on the web →</a></p>
      </div>
    </div>
  </section>
</Base>
<script>
  const picker = document.querySelector<HTMLSelectElement>('#mcp-client');
  const container = document.querySelector<HTMLElement>('#client-picker');
  if (picker && container) {
    container.hidden = false;
    const selectClient = () => {
      for (const guide of document.querySelectorAll<HTMLElement>('[data-client]')) guide.hidden = guide.dataset.client !== picker.value;
    };
    picker.addEventListener('change', selectClient);
    selectClient();
  }
</script>
<style>
  .mcp-hero { position: relative; overflow: hidden; background: var(--ctdc-midnight); color: var(--ctdc-on-dark-strong); }
  .mcp-hero-content { position: relative; padding-top: 4rem; padding-bottom: 3.5rem; }
  .mcp-art { position: absolute; width: min(67vw, 900px); right: -6%; bottom: -9%; opacity: .65; pointer-events: none; }
  .mcp-hero .eyebrow { color: var(--ctdc-gold); }
  h1 { font-size: clamp(2.3rem, 4vw, 3.8rem); max-width: 700px; margin: 1.2rem 0; letter-spacing: -.035em; }
  h1 span { color: var(--ctdc-gold); }
  .mcp-lead { font-size: clamp(1.6rem, 2.5vw, 2.5rem); line-height: 1.15; margin: 1.3rem 0; }
  .mcp-intro { max-width: 440px; color: var(--ctdc-on-dark); font-size: 1.13rem; margin-bottom: 1.5rem; }
  .mcp-platforms { font-size: .9rem; margin-top: 1rem; color: var(--ctdc-on-dark); }
  .mcp-actions { display: flex; flex-wrap: wrap; gap: .8rem; }
  .setup-choices { display: grid; grid-template-columns: repeat(2, max-content); gap: 1.3rem 2rem; margin-top: 1.5rem; }
  .setup-choices h2 { font-size: 1rem; margin-bottom: .6rem; color: var(--ctdc-on-dark); }
  .setup-choices .btn { touch-action: manipulation; }
  .setup-reviewed { margin-top: 1.5rem; }
  .setup-group + .setup-group { margin-top: 3rem; }
  .setup-group > .mcp-note { margin-bottom: 1.8rem; }
  .setup-list { padding-left: 1.3rem; margin: 1rem 0; }
  .setup-list > li { padding-left: .25rem; margin-bottom: .85rem; }
  .setup-list .copy-command { margin-top: .5rem; }
  .mcp-step, .mcp-step h3, .setup-group h2, #setup { scroll-margin-top: 9rem; }
  .mcp-layout { display: grid; grid-template-columns: 1fr 1.75fr; gap: clamp(2rem, 6vw, 6rem); }
  .mcp-layout h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-bottom: 1rem; }
  .mcp-orientation { position: sticky; top: 2rem; align-self: start; }
  .mcp-orientation p { max-width: 330px; }
  .mcp-steps { min-width: 0; }
  .manual-setup { border: 0; padding: 0; }
  .manual-setup > summary { font-size: 1.4rem; }
  .manual-setup > .mcp-layout { padding-top: 2rem; }
  .mcp-step { padding: 0 0 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--ctdc-hairline-on-light); }
  .mcp-step:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .step-number { color: var(--ctdc-primary); text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; font-weight: 700; }
  .mcp-step h3 { font-size: 1.55rem; }
  .mcp-note { font-size: .92rem; color: var(--ctdc-ink-muted); }
  #client-picker { margin: 1rem 0; }
  label { display: block; font-weight: 600; margin-bottom: .3rem; }
  select { width: 100%; padding: .7rem; border: 1px solid var(--ctdc-ink-muted); background: var(--ctdc-surface); font: inherit; border-radius: 4px; }
  .client-guide { animation: arrive .2s ease-out; }
  .client-guide h4 { margin-top: 1.3rem; }
  .mcp-prompt { display: flex; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--ctdc-hairline-on-light); }
  .mcp-prompt:first-child { padding-top: 0; }
  .mcp-prompt span { color: var(--ctdc-primary); font: .8rem var(--ctdc-font-mono); padding-top: .4rem; }
  .mcp-prompt p { font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.4; margin: 0; }
  details { border-bottom: 1px solid var(--ctdc-hairline-on-light); padding: 1rem 0; }
  summary { font-size: 1.15rem; font-weight: 600; cursor: pointer; }
  details p { margin-top: .8rem; }
  .mcp-more { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  @keyframes arrive { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: no-preference) { .mcp-hero-content { animation: arrive .5s ease-out; } }
  @media (prefers-reduced-motion: reduce) { .client-guide { animation: none; } :global(html) { scroll-behavior: auto; } }
  @media (max-width: 1000px) { .setup-choices { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .mcp-layout { grid-template-columns: 1fr; gap: 2rem; } .mcp-orientation { position: static; } .mcp-hero-content { padding-top: 2.5rem; padding-bottom: 2rem; } .mcp-art { width: 110vw; right: -45%; opacity: .18; } }
</style>
