---
import html from '../../../../docs/youtube-coverage/research/filename-viewer.html?raw';
const css = html.match(/<style>([\s\S]*?)<\/style>/)?.[1];
const body = html.match(/<body>([\s\S]*?)<script type="module"/)?.[1];
if (!css || !body) throw new Error('Filename viewer template is missing its style or body.');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Document filenames · Congressional Tech</title>
    <meta name="description" content="Review filename classifications, publisher provenance, and saved-response coverage across the congressional document archive." />
    <style is:global set:html={css}></style>
  </head>
  <body>
    <Fragment set:html={body} />
    <script>import '../components/filename-bootstrap.mjs';</script>
  </body>
</html>
