---
import { withBase } from '../lib/paths';
const destination = withBase('/dashboard/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Document filenames</title>
  <link rel="canonical" href={destination} />
  <script is:inline define:vars={{ destination }}>
    location.replace(destination + location.search + location.hash);
  </script>
</head>
<body>
  <p><a id="dashboard" href={destination}>Continue to Committee Explorer</a></p>
  <script is:inline define:vars={{ destination }}>
    const link = document.getElementById('dashboard');
    if (link) link.href = destination + location.search + location.hash;
  </script>
</body>
</html>
