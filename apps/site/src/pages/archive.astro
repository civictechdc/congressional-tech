---
import Base from '../layouts/Base.astro';
import ArchiveExplorer from '../components/explorer/archive/ArchiveExplorer';
import { withBase } from '../lib/paths';
import '../styles/explorer.css';
import '../styles/archive.css';
const pointerUrl=import.meta.env.PUBLIC_ARCHIVE_POINTER_URL||'https://congressional-data.spicygov.ai/viewer-publications/manifest.json';
const rawBase=import.meta.env.PUBLIC_ARCHIVE_RAW_BASE_URL||'https://congressional-data.spicygov.ai/';
---
<Base title="Congress Explorer" active="archive" description="Search congressional committee hearings, witness statements, bills, markups, saved copies, and recovered records.">
  <section class="explorer-page explorer-archive-page">
    <div class="container">
      <div class="explorer-page-heading">
        <div>
          <p class="eyebrow">Congressional records</p>
          <h1>Congress Explorer</h1>
          <p class="explorer-note">Browse hearings, committees, witnesses, members, bills, nominations, and preserved documents.</p>
        </div>
        <div class="explorer-page-links">
          <a href={withBase('/mcp/')}>Use this data with your AI assistant</a>
        </div>
      </div>
      <ArchiveExplorer pointerUrl={pointerUrl} rawBase={rawBase} client:load />
      <noscript><p>JavaScript is required to search Congress Explorer.</p></noscript>
    </div>
  </section>
</Base>
