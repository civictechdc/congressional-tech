{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate:explorer-types": "node scripts/generate-explorer-types.mjs",
    "check:explorer-types": "node scripts/generate-explorer-types.mjs --check",
    "test:explorer": "node --test src/components/explorer/reader/*.test.ts src/components/explorer/browse/*.test.ts src/components/explorer/reader/filenames/*.test.mjs scripts/archive-presentation.test.mjs scripts/archive-tools.test.mjs",
    "test:archive-unit": "node --test src/components/explorer/reader/archive-unit.test.ts",
    "test:archive-native": "node --test scripts/archive-reader.test.mjs",
    "test:archive-presentation": "node --test scripts/archive-presentation.test.mjs",
    "test:archive-tools": "node --test scripts/archive-tools.test.mjs",
    "canary:archive": "node --expose-gc scripts/verify-archive.mjs",
    "measure:archive": "node scripts/measure-archive.mjs",
    "targets:archive": "node scripts/archive-targets.mjs",
    "contract:archive": "node scripts/contract-archive.mjs",
    "contract:archive-ci": "../../.venv/bin/python -I ../../.github/scripts/verify-archive-contract.py",
    "test:archive-f0": "node --test scripts/archive-f0.test.mjs",
    "test:archive-shards": "node --test scripts/archive-shards.test.mjs",
    "canary:archive-local": "node --expose-gc scripts/canary-archive-local.mjs",
    "test:archive-saved-browser": "node scripts/archive-saved-browser.mjs",
    "test:archive-heap-browser": "node scripts/archive-heap-browser.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@fontsource/source-code-pro": "^5.2.5",
    "@fontsource/source-sans-3": "^5.2.5",
    "astro": "^5.13.0",
    "hyparquet": "1.31.2",
    "hyparquet-compressors": "1.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "npm@11.19.1"
}
