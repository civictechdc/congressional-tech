            <a href='#' class='clip-preview preview-end' rel='nofollow'>Preview End</a>
          </div>
          <div class='step-two'>
            <div class='title video-page-clip-text-input'>Title<input type='text' name='title' value=':::clipTitle:::' required='required'></div>
