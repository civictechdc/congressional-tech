+def test_context_cache_budget_eviction_and_oversize_rescans(context_store):
+    import pickle
+    import sys
+    context = context_store
+    other = LINK + '-other'
+    for url in (LINK, other):
+        context.add_url(url, {'source_link_label': ['same small result']})
+    value = context.for_url(LINK)
+    budget = sys.getsizeof(pickle.dumps(value, protocol=pickle.HIGHEST_PROTOCOL)) + sys.getsizeof(other) + 256
+    context.finalize(cache_bytes=budget)
+    context.for_url(LINK)
+    context.for_url(other)
+    scans = context.statistics['context_occurrence_scans']
+    context.for_url(LINK)
+    assert context.statistics['context_cache_evictions'] == 2
+    assert context.statistics['context_occurrence_scans'] == scans + 1
+    assert 0 < context.statistics['context_cache_bytes'] <= budget
+    assert context.statistics['context_cache_peak_bytes'] <= budget
+
+
