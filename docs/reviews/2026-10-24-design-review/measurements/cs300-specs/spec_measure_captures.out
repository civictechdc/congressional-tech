
## rows, distinct sha, null sha rows, distinct lines, distinct receipt files
SELECT count(*), count(DISTINCT sha256), count(*) FILTER (WHERE sha256 IS NULL), count(DISTINCT (receipt_key, receipt_line)), count(DISTINCT receipt_key) FROM read_parquet('/Users/mikewolfd/Work/congressional-tech/output/incremental-updates-20261019/adoption-inputs/captures.parquet')
-> [(3909134, 1036256, 1041865, 2596054, 2289)]

## reference_kind / resolution distribution
SELECT reference_kind, resolution, count(*) FROM read_parquet('/Users/mikewolfd/Work/congressional-tech/output/incremental-updates-20261019/adoption-inputs/captures.parquet') GROUP BY 1,2 ORDER BY 3 DESC LIMIT 20
