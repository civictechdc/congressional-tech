    "queries": [
      {
        "name": "listing_candidates",
        "sql": "SELECT * FROM m WHERE n_urls BETWEEN 2 AND 20 AND max_bytes BETWEEN 500 AND 1500000\n AND lower(context_url) NOT LIKE '%gpo.gov%' AND lower(context_url) NOT LIKE '%govinfo.gov%'\n AND lower(last_context_url) NOT LIKE '%gpo.gov%' AND lower(last_context_url) NOT LIKE '%govinfo.gov%'\n AND context_url NOT LIKE '%youtube%'\n AND regexp_match(lower(regexp_replace(context_url,'[?#].*$','')),'[.](pdf|xml|docx?|txt|zip)$') IS NULL\n AND regexp_match(lower(regexp_replace(last_context_url,'[?#].*$','')),'[.](pdf|xml|docx?|txt|zip)$') IS NULL\n ORDER BY n_urls DESC,sha256 LIMIT 40"
      }
    ]
  },
