    ],
    "steps": [
      {
        "name": "matched",
        "sql": "SELECT s.sha256,s.seed_kind,s.quota,c.body_key,c.context_url,c.original_path,c.family,c.bytes,c.http_status,c.receipt_key,c.receipt_line,\n row_number() OVER(PARTITION BY s.sha256 ORDER BY c.context_url NULLS LAST,c.original_path NULLS LAST,c.receipt_key NULLS LAST,c.receipt_line) AS context_rank\n FROM cap c JOIN seeds s ON c.sha256=s.sha256",
        "materialize": true
      },
      {
        "name": "summary",
        "sql": "SELECT sha256,count(DISTINCT context_url) AS n_urls,max(context_url) AS last_context_url,\n max(bytes) AS max_bytes FROM matched GROUP BY sha256",
        "materialize": false
      },
      {
        "name": "population",
        "sql": "SELECT m.*,s.n_urls,s.last_context_url,s.max_bytes,lower(regexp_replace(regexp_replace(coalesce(m.context_url,''),'^https?://',''),'/.*$','')) AS host,\n CASE WHEN s.max_bytes<5000 THEN 'under5k' WHEN s.max_bytes<15000 THEN '5to15k' WHEN s.max_bytes<40000 THEN '15to40k' ELSE '40kplus' END AS size_bucket\n FROM matched m JOIN summary s ON m.sha256=s.sha256 WHERE m.context_rank=1",
        "materialize": false
      },
      {
        "name": "stratified",
        "sql": "SELECT *,row_number() OVER(PARTITION BY seed_kind,host,size_bucket ORDER BY encode(sha256('S2-20261027:'||sha256),'hex')) AS within_stratum_rank FROM population",
        "materialize": false
      },
      {
        "name": "ranked",
        "sql": "SELECT *,row_number() OVER(PARTITION BY seed_kind ORDER BY within_stratum_rank,encode(sha256('S2-20261027:'||sha256),'hex')) AS selection_rank FROM stratified",
        "materialize": false
      }
    ],
    "outputs": [
